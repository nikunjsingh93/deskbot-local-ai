# DeskBot backend
PORT=5175
DATA_DIR=./data
LOG_DIR=./logs

# Host allowlist for backend proxying.
# Add your Ubuntu Ollama IP here. Keep this restrictive.
ALLOWED_LLM_HOSTS=localhost,127.0.0.1,192.168.1.213

# Safe mode: blocks risky names and caps output/context.
SERVER_SAFE_MODE=true
BLOCKED_OLLAMA_MODEL_PATTERNS=llama,llava,vision,moondream,minicpm,70b,65b,34b,32b,30b,27b,24b,22b,14b,13b,12b,11b,10b,8x
MAX_MODEL_SIZE_GB=2.5

# Ollama generation safety. Very conservative defaults.
OLLAMA_NUM_CTX=1024
OLLAMA_NUM_PREDICT=160
OLLAMA_NUM_THREAD=4
OLLAMA_KEEP_ALIVE=0
OLLAMA_TEMPERATURE=0.7
OLLAMA_TOP_K=40
OLLAMA_TOP_P=0.9

# Request protection. This app never allows parallel LLM calls.
CHAT_TIMEOUT_MS=30000
MODEL_FETCH_TIMEOUT_MS=10000
UNLOAD_TIMEOUT_MS=8000
OLLAMA_ERROR_COOLDOWN_MS=30000
MAX_HISTORY_MESSAGES=4
MAX_MESSAGE_CHARS=1200

# Do not set this true unless you understand the risk.
AUTO_EXPLICIT_UNLOAD_AFTER_CHAT=false
